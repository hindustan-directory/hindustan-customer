# Production / staging (HTTPS default in app when unset):
# EXPO_PUBLIC_API_BASE_URL=https://13.204.231.151/api/v1
#
# Local backend (dev + sideload release APK with EXPO_PUBLIC_ALLOW_CLEARTEXT=true):
# EXPO_PUBLIC_API_BASE_URL=http://192.168.1.76:4000/api/v1
# EXPO_PUBLIC_ALLOW_CLEARTEXT=true

# Required for release builds (./build-apk.sh / ./build-production.sh):
# EXPO_PUBLIC_API_BASE_URL_PROD=https://your-production-api.example.com/api/v1

# Android release signing (required for local release builds; keystore file is gitignored)
# RELEASE_KEYSTORE_FILE=hindustan-customer-release-key.keystore
# RELEASE_KEYSTORE_PASSWORD=
# RELEASE_KEY_ALIAS=
# RELEASE_KEY_PASSWORD=
